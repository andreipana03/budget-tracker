# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Your public hostname (no https://), e.g. budget.example.com or myapp.duckdns.org
DOMAIN=

# POSTGRES_PASSWORD goes inside a URL, so use letters and digits only:  openssl rand -hex 24
# JWT_SECRET:  openssl rand -base64 36
POSTGRES_PASSWORD=
JWT_SECRET=

# Google sign-in (optional). Same web client id for both lines. Leave empty to hide the button.
GOOGLE_CLIENT_IDS=
VITE_GOOGLE_CLIENT_ID=

# Email (verification, password reset). The API supports STARTTLS, so use port 587.
# Use "log" to only print emails to the API log until you set up a provider.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Budget Tracker <no-reply@your-domain>
