# Optional: copy to backend/.env to override the local defaults set in the root Makefile.
DATABASE_URL=postgres://budget:budget@localhost:5432/budget_tracker?sslmode=disable
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# At least 32 bytes. The Makefile's default is for local development only.
# JWT_SECRET=

# Google sign-in: the OAuth client id(s) whose ID tokens are accepted, comma-separated
# (web client id now, iOS client id later). See README.md › Google sign-in.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com

# Email: "smtp" sends to Mailpit locally (inbox http://localhost:8025); "log" prints emails to the log.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Budget Tracker <no-reply@budget-tracker.test>

# Background jobs (BNR exchange rates, subscriptions coming due, cleanup).
JOBS_ENABLED=true
