# Optional: copy to web/.env.local to change these.

# Where the web app sends API requests. "/api" goes through the Vite dev proxy (same origin,
# so the refresh cookie works in every browser, Safari included).
VITE_API_BASE_URL=/api
# Where the Vite dev proxy forwards /api.
VITE_API_PROXY_TARGET=http://localhost:8080

# Google sign-in: the OAuth web client id. The Google button stays hidden while this is empty.
# See README.md › Google sign-in.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
